{
  "name": "@hotcodepush/cordova-code-push",
  "version": "0.0.0",
  "description": "Cordova code push by HotCodePush: the plugin that delivers over-the-air updates to your Cordova app",
  "license": "MIT",
  "author": "Genz IT Solutions GmbH",
  "homepage": "https://hotcodepush.com/cordova-code-push",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotcodepush-team/cordova-code-push.git"
  },
  "bugs": {
    "url": "https://github.com/hotcodepush-team/cordova-code-push/issues"
  },
  "keywords": [
    "cordova",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "code push",
    "hot code push",
    "live updates",
    "ota updates",
    "over-the-air updates"
  ],
  "types": "dist/definitions.d.ts",
  "files": [
    "dist/",
    "scripts/add-binary-create-phase.js",
    "scripts/binary-create-xcode.sh",
    "src/android/",
    "src/ios/",
    "Package.swift",
    "plugin.xml"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf ./dist",
    "fmt": "eslint . --fix && prettier --write . && swiftlint --fix --quiet",
    "lint": "eslint . && prettier --check . && swiftlint lint --quiet --strict",
    "test": "node --test scripts/*.test.mjs src/*.test.mjs",
    "test:android": "cd tests/android && ./gradlew test --console=plain",
    "test:ios": "xcodebuild test -scheme \"$(basename \"$PWD\")\" -destination 'platform=macOS,variant=Mac Catalyst' -quiet",
    "verify": "npm run lint && npm test && npm run build",
    "verify:android": "npm run build && node scripts/build-test-app.mjs android",
    "verify:ios": "npm run build && node scripts/build-test-app.mjs ios"
  },
  "dependencies": {
    "@hotcodepush/protocol": "https://pkg.pr.new/hotcodepush-team/protocol/@hotcodepush/protocol@867e33cec9d27031323cf888bf79eaf45a14d761",
    "xcode": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cordova": "13.0.0",
    "cordova-android": "15.1.0",
    "cordova-ios": "8.1.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.8",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "cordova": {
    "id": "@hotcodepush/cordova-code-push",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "engines": {
    "cordovaDependencies": {
      "0.0.0": {
        "cordova-android": ">=14.0.0",
        "cordova-ios": ">=8.0.0"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
